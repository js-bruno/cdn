# Copy to .env and fill in. Never commit .env (it is gitignored).

# Public CDN host (listagem fechada)
CDN_HOST=cdn.thisdev.space

# Admin host (basic_auth + browse + upload)
ADMIN_HOST=admin.thisdev.space

# ACME account e-mail for automatic HTTPS
ACME_EMAIL=admin@thisdev.space

# Admin basic auth. Generate the hash with: ./deploy/scripts/gen-hash.sh 'sua-senha'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=$2a$14$SUBSTITUA_PELO_HASH_GERADO

# Used by deploy/scripts/deploy-rsync.sh (local -> VPS)
DEPLOY_HOST=deploy@seu-ip-ou-host
