# Local dev Caddyfile. Run from the repo root with: cdn-dev
#   http://localhost:8080  -> público (sem browse, segue a listagem fechada)
#   http://localhost:8081  -> admin (browse + upload + Sync), SEM auth (localhost)
{
	order webdav before file_server
	auto_https off
}

http://localhost:8080 {
	root * ./content
	encode zstd gzip

	@assets path *.css *.js *.mjs *.map *.woff *.woff2 *.ttf *.otf \
 *.png *.jpg *.jpeg *.gif *.webp *.avif *.svg *.ico *.json
	header @assets Access-Control-Allow-Origin "*"
	header @assets Cache-Control "public, max-age=86400"

	@hashed path_regexp hashed \.[0-9a-f]{8,}\.[a-z0-9]+$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	file_server
}

http://localhost:8081 {
	root * ./content
	encode zstd gzip

	@get method GET HEAD
	route {
		file_server @get {
			browse ./browse.html
		}
		webdav
	}
}
